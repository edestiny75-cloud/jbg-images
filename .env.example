# --- Database ---------------------------------------------------------------
# Supabase project ajwzfhddyhkdoosomuaz -> Settings -> Database -> Connection string.
# DATABASE_URL uses the pooler (port 6543); DIRECT_URL is the direct connection
# (port 5432) and is only used for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional: a SEPARATE empty database Prisma uses for migration drift detection.
# Not the same as DIRECT_URL. Leave blank unless you have one.
SHADOW_DATABASE_URL=""

# --- Auth -------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Integrations -----------------------------------------------------------
# Server-side only. The legacy tool POSTed this from the browser with
# mode:'no-cors', so every delivery failure was invisible.
SLACK_WEBHOOK_URL=""

# Shared secret the Fiery print agent presents to /api/print-jobs/*.
# Generate with: openssl rand -hex 32
PRINT_AGENT_TOKEN=""

# --- Asset locations --------------------------------------------------------
# Single source of truth. $GCS_PRINTS and the Supabase storage prefixes were
# duplicated between index.html:816-825 and agent/JBG_Fiery_Agent.ps1:60-61.

# Production poster print PDFs (Google Cloud Storage).
GCS_PRINTS_URL="https://storage.googleapis.com/jbg-print-files-2026/"

# Supabase public storage. Product thumbnails, side-B scans and FNSKU sheets
# live under /thumbs/; the 30-up FNSKU label PDFs live under /prints/.
SUPABASE_PUBLIC_URL="https://ajwzfhddyhkdoosomuaz.supabase.co/storage/v1/object/public"
